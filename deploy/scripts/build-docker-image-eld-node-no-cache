#!/usr/bin/env bash
# Rebuild local eld-base + eld-app with no Docker layer cache (forces cargo rebuild).
# Same tags as build-docker-image-eld-node (NODE_APP_VERSION_TAG from deploy/.env).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "${SCRIPT_DIR}/build-docker-image-eld-node" --no-cache
