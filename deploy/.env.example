# Tendermint source: compile (`make build`) and the image both use this tree (any local path).
# Required by deploy/scripts/_env.sh.
TENDERMINT_DIR=../third_party/tendermint

# Required image version tags (OS + version, e.g. macos-0.0.16). Scripts refuse to run if unset.
TENDERMINT_VERSION_TAG=macos-0.0.16
NODE_APP_VERSION_TAG=macos-0.0.20

# Image tag for ghcr.io/eldnetwork/eld-chain (compose.ghcr*.yaml).
# Same string as the git tag that publishes the image (eld-app-v0.0.20).
NODE_APP_VERSION_TAG_GHCR=eld-app-v0.0.20

# Rust Tendermint image for compose.ghcr.tm-rs.yaml / compose.tm-rs.yaml.
# Full reference, including the version tag.
TM_RS_IMAGE=ghcr.io/eldnetwork/eld-tendermint-rs:v0.34.24-eld-tm-rs.6

# Image tag for ghcr.io/eldnetwork/eld-faucet and the local eld-faucet image.
# Git tag eld-faucet-v0.0.3 publishes image tag v0.0.3.
# Required only for --with-faucet.
FAUCET_VERSION_TAG=v0.0.3

# Image tag for ghcr.io/eldnetwork/eld-analytics (compose.ghcr.tm-rs.yaml).
# Git tag eld-analytics-v0.0.3 publishes that same string as the image tag.
# Required only for --with-analytics on cluster-start-without-history.ghcr.tm-rs.sh.
ANALYTICS_TAG_GHCR=eld-analytics-v0.0.3

# Token for query /frontier_appstate. The app and Tendermint containers both
# receive this value. Start scripts exit when it is empty. This is not the ABCI snapshot connection.
ELD_SNAPSHOT_QUERY_TOKEN=exampletoken123
