# Build context is the eld-chain repository root.
FROM rust:1.88.0-bookworm

RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    libclang-dev \
    pkg-config \
    libssl-dev \
    libudev-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY common ./common
COPY client ./client
COPY node_app ./node_app
# eld-cli and faucet are separate images/processes. Cargo still loads every
# workspace member, so drop members that were not copied before building.
RUN sed -i 's/, "cli"//g; s/, "faucet"//g' Cargo.toml \
    && cargo build -p eld-node
