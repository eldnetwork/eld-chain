# Build context is the eld-chain repository root.
# Named context eld_tm is the sibling eld-tendermint-rs checkout.
# node_app resolves ../../eld-tendermint-rs from /app/node_app.
FROM rust:1.88.0-bookworm

RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    libclang-dev \
    pkg-config \
    libssl-dev \
    libudev-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY common ./common
COPY client ./client
COPY node_app ./node_app
# Workspace [patch.crates-io] replaces tendermint-proto 0.23.7 with this tree.
COPY vendor/tendermint-proto ./vendor/tendermint-proto
COPY --from=eld_tm . /eld-tendermint-rs
# eld-cli, faucet, and analytics are separate images/processes. Cargo still
# loads every workspace member, so drop members that were not copied before building.
RUN sed -i 's/, "cli"//g; s/, "faucet"//g; s/, "analytics"//g' Cargo.toml \
    && cargo build -p eld-node
