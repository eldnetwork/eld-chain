# Release image published to GHCR (linux/amd64 and linux/arm64).
# Local debug images stay on Dockerfile.eld-base + Dockerfile.app.
# Build context is the repository root.
# Named context eld_tm is the eld-tendermint-rs checkout (CI passes the tag
# checkout; node_app resolves ../../eld-tendermint-rs from /app/node_app).
FROM rust:1.88.0-bookworm AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    libclang-dev \
    pkg-config \
    libssl-dev \
    libudev-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY common ./common
COPY client ./client
COPY node_app ./node_app
# Workspace [patch.crates-io] replaces tendermint-proto 0.23.7 with this tree.
COPY vendor/tendermint-proto ./vendor/tendermint-proto
COPY --from=eld_tm . /eld-tendermint-rs
# eld-cli, faucet, and analytics are separate images/processes. Cargo still
# loads every workspace member, so drop members that were not copied.
# metadata (online) rewrites the lock for the reduced workspace; --locked then
# pins that lock. Do not use --offline here: a fresh image has no crates cache.
RUN sed -i 's/, "cli"//g; s/, "faucet"//g; s/, "analytics"//g' Cargo.toml \
    && cargo metadata --format-version 1 >/dev/null \
    && cargo build --release --locked -p eld-node

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r -g 1000 elduser \
    && useradd -r -u 1000 -g elduser elduser \
    && mkdir -p /app/data /app/config /app/wallets \
    && chown -R elduser:elduser /app

COPY --from=build /app/target/release/eld-node /usr/local/bin/eld-node
RUN chmod 755 /usr/local/bin/eld-node \
    && ldd /usr/local/bin/eld-node \
    && ! ldd /usr/local/bin/eld-node | grep -q 'not found'

WORKDIR /app
USER elduser

EXPOSE 26658
EXPOSE 8000
EXPOSE 6881
EXPOSE 25401
EXPOSE 8085
EXPOSE 4001
EXPOSE 4002

CMD ["eld-node"]
