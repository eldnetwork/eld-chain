# GHCR and local image for eld-faucet. Build context is the repository root.
# Config, wallet, and SQLite are mounted at runtime; nothing secret is copied.
FROM rust:1.88.0-bookworm AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    libclang-dev \
    pkg-config \
    libssl-dev \
    libudev-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY common ./common
COPY client ./client
COPY faucet ./faucet
# Cargo loads every workspace member. Drop members that were not copied.
# metadata (online) rewrites the lock for the reduced workspace; --locked then
# pins that lock. Do not use --offline here: a fresh image has no crates cache.
RUN sed -i 's/, "cli"//g; s/, "node_app"//g' Cargo.toml \
    && cargo metadata --format-version 1 >/dev/null \
    && cargo build --release --locked -p eld-faucet

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r -g 1000 elduser \
    && useradd -r -u 1000 -g elduser elduser \
    && mkdir -p /app/data /app/config /app/wallets \
    && chown -R elduser:elduser /app

COPY --from=build /app/target/release/eld-faucet /usr/local/bin/eld-faucet
RUN chmod 755 /usr/local/bin/eld-faucet \
    && ldd /usr/local/bin/eld-faucet \
    && ! ldd /usr/local/bin/eld-faucet | grep -q 'not found'

WORKDIR /app
USER elduser
EXPOSE 8080
CMD ["eld-faucet"]
